{
  "elements": [
    {
      "type": "CheckBox",
      "name": "Active",
      "caption": "Instanz aktiv"
    },
    {
      "type": "ExpansionPanel",
      "caption": "Anlage und RSCP-Verbindung",
      "expanded": true,
      "items": [
        {
          "type": "RowLayout",
          "items": [
            {
              "type": "Select",
              "name": "OperatingMode",
              "caption": "Betriebsart",
              "options": [
                {
                  "caption": "Automatisch",
                  "value": "auto"
                },
                {
                  "caption": "Einzelgerät (Standalone)",
                  "value": "standalone"
                },
                {
                  "caption": "Farm",
                  "value": "farm"
                }
              ],
              "onChange": "if ($OperatingMode === 'farm') { echo E3DCF_DiscoverLAN($id, $LanNetwork ?? '', $Host ?? '', 0, 0, 'farm'); }"
            },
            {
              "type": "Button",
              "caption": "Geräte im LAN suchen",
              "onClick": "echo E3DCF_DiscoverLAN($id, $LanNetwork, $Host, 0, 0, $OperatingMode);"
            }
          ]
        },
        {
          "type": "RowLayout",
          "items": [
            {
              "type": "ValidationTextBox",
              "name": "Host",
              "caption": "Hauptgerät oder Farmcontroller (IP)"
            },
            {
              "type": "ValidationTextBox",
              "name": "SecondHost",
              "caption": "Zweites Farmgerät (IP, optional)"
            }
          ]
        },
        {
          "type": "Label",
          "caption": "Vor der LAN-Suche die RSCP-Zugangsdaten speichern. Die Auswahl „Farm“ startet die Suche automatisch."
        },
        {
          "type": "ExpansionPanel",
          "caption": "RSCP-Zugangsdaten",
          "expanded": false,
          "items": [
            {
              "type": "CheckBox",
              "name": "ReadRscpSolar",
              "caption": "Lokales RSCP verwenden"
            },
            {
              "type": "Label",
              "caption": "Anmeldung für Hauptgerät, Farmcontroller und weitere Farmgeräte"
            },
            {
              "type": "RowLayout",
              "items": [
                {
                  "type": "ValidationTextBox",
                  "name": "FarmRscpUser",
                  "caption": "RSCP-Benutzer"
                },
                {
                  "type": "PasswordTextBox",
                  "name": "FarmRscpPassword",
                  "caption": "RSCP-Benutzerpasswort"
                },
                {
                  "type": "PasswordTextBox",
                  "name": "FarmRscpKey",
                  "caption": "RSCP-Verschlüsselungsschlüssel"
                }
              ]
            },
            {
              "type": "Label",
              "caption": "Farmmaster als Einzelgerät (optional). Die Portal-Zugangsdaten gelten für die lokale Abfrage über den Einzelgeräte-Port."
            },
            {
              "type": "RowLayout",
              "items": [
                {
                  "type": "ValidationTextBox",
                  "name": "MasterPortalUser",
                  "caption": "E3/DC-Portal-E-Mail"
                },
                {
                  "type": "PasswordTextBox",
                  "name": "MasterPortalPassword",
                  "caption": "E3/DC-Portalpasswort"
                }
              ]
            }
          ]
        },
        {
          "type": "ExpansionPanel",
          "caption": "Erweiterte Verbindungseinstellungen",
          "expanded": false,
          "items": [
            {
              "type": "RowLayout",
              "items": [
                {
                  "type": "NumberSpinner",
                  "name": "DeviceRscpPort",
                  "caption": "RSCP-Port der Einzelgeräte",
                  "minimum": 1,
                  "maximum": 65535
                },
                {
                  "type": "NumberSpinner",
                  "name": "FarmRscpPort",
                  "caption": "RSCP-Port des Farmcontrollers",
                  "minimum": 1,
                  "maximum": 65535
                }
              ]
            },
            {
              "type": "ValidationTextBox",
              "name": "LanNetwork",
              "caption": "LAN-Suchnetz (optional, z. B. 192.168.178.0/24)"
            },
            {
              "type": "RowLayout",
              "items": [
                {
                  "type": "NumberSpinner",
                  "name": "Interval",
                  "caption": "Live-Abfrage (Sekunden)",
                  "minimum": 5,
                  "maximum": 3600
                },
                {
                  "type": "NumberSpinner",
                  "name": "RscpDetailInterval",
                  "caption": "Detailabfrage (Sekunden, 0 = nur manuell)",
                  "minimum": 0,
                  "maximum": 3600
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Zusatzzähler, Wallbox und Zubehör",
      "expanded": false,
      "items": [
        {
          "type": "Label",
          "caption": "Erkannte Geräte erscheinen automatisch. Die Spalte „Funktion“ zeigt ihre automatische Zuordnung. Anzeigename und Sichtbarkeit lassen sich in der Tabelle ändern."
        },
        {
          "type": "Button",
          "caption": "RSCP-Zubehör suchen",
          "onClick": "echo E3DCF_ScanRscpAccessories($id);",
          "confirm": "Die Suche lädt das Formular neu. Ungespeicherte Änderungen gehen verloren. Zubehör jetzt suchen?"
        },
        {
          "type": "List",
          "name": "AccessoryOptions",
          "caption": "Zubehör",
          "rowCount": 12,
          "add": false,
          "delete": false,
          "columns": [
            {
              "caption": "Kennung",
              "name": "Key",
              "width": "130px",
              "save": true
            },
            {
              "caption": "Anzeigename",
              "name": "Name",
              "width": "auto",
              "add": "",
              "edit": {
                "type": "ValidationTextBox"
              }
            },
            {
              "caption": "Funktion",
              "name": "Role",
              "width": "150px",
              "save": false
            },
            {
              "caption": "Status",
              "name": "Current",
              "width": "125px"
            },
            {
              "caption": "Sichtbar",
              "name": "Visible",
              "width": "80px",
              "add": true,
              "edit": {
                "type": "CheckBox"
              }
            }
          ],
          "loadValuesFromConfiguration": false,
          "values": []
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Visualisierung",
      "expanded": false,
      "items": [
        {
          "type": "Select",
          "name": "EnergyFlowTheme",
          "caption": "Farbschema",
          "options": [
            {
              "caption": "Dunkel",
              "value": "dark"
            },
            {
              "caption": "Hell",
              "value": "light"
            },
            {
              "caption": "Automatisch (Geräteeinstellung)",
              "value": "auto"
            }
          ]
        },
        {
          "type": "Label",
          "caption": "Eigene CSS-Regeln überschreiben das Farbschema und die Standardgestaltung. Verwende die Klasse .e3dc-flow, um Regeln auf die Kachel zu begrenzen."
        },
        {
          "type": "ValidationTextBox",
          "name": "EnergyFlowCss",
          "caption": "Eigenes CSS für die Energiefluss-Kachel",
          "multiline": true
        },
        {
          "type": "ExpansionPanel",
          "caption": "IPSView",
          "expanded": false,
          "items": [
            {
              "type": "Label",
              "caption": "Erstellt unter Visualisierung eine bearbeitbare Energiefluss-View mit nativen IPSView-Elementen. Zum Bearbeiten wird der IPSView Designer benötigt."
            },
            {
              "type": "Button",
              "caption": "IPSView Energiefluss anlegen",
              "onClick": "echo E3DCF_CreateIpsViewEnergyFlow($id);"
            }
          ]
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Zusätzliche Variablen",
      "expanded": false,
      "items": [
        {
          "type": "CheckBox",
          "name": "ExposeDailyValues",
          "caption": "Tageswerte und Solarprognose"
        },
        {
          "type": "CheckBox",
          "name": "ExposeDeviceDetails",
          "caption": "Gerätedetails, Phasenwerte und RSCP-Rohdaten"
        },
        {
          "type": "CheckBox",
          "name": "ExposeDiagnostics",
          "caption": "Erweiterte Verbindungsdiagnose"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Installierte Batteriekapazität",
      "expanded": false,
      "items": [
        {
          "type": "Label",
          "caption": "0 verwendet plausible Gerätewerte. Eine bestätigte Gesamtkapazität hat im Farmbetrieb Vorrang. Beispiel: 41,3 kWh entsprechen 41300 Wh."
        },
        {
          "type": "NumberSpinner",
          "name": "MasterInstalledCapacityWh",
          "caption": "Hauptgerät oder Farmmaster (Wh)",
          "minimum": 0
        },
        {
          "type": "NumberSpinner",
          "name": "PeerInstalledCapacityWh",
          "caption": "Zweites Farmgerät (Wh)",
          "minimum": 0
        },
        {
          "type": "NumberSpinner",
          "name": "FarmInstalledCapacityWh",
          "caption": "Farm gesamt (Wh)",
          "minimum": 0
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Solarprognose",
      "expanded": false,
      "items": [
        {
          "type": "Label",
          "caption": "Eine vorhandene Prognosevariable in kWh kann hier verknüpft werden."
        },
        {
          "type": "SelectVariable",
          "name": "ForecastSource",
          "caption": "Symcon-Variable für Solarprognose heute (kWh)"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Lokale Steuerung",
      "expanded": false,
      "items": [
        {
          "type": "Label",
          "caption": "Die Freigabe erlaubt Änderungen an Batterie-Sollleistung, Ladeeinstellungen und Sperrzeiten. Ein Befehl wird erst durch eine Aktion oder ein Skript gesendet."
        },
        {
          "type": "CheckBox",
          "name": "AllowBatteryControl",
          "caption": "Lokale RSCP-Schreibbefehle freigeben"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Externe Systeme",
      "expanded": false,
      "items": [
        {
          "type": "Label",
          "caption": "Hier zusätzliche Erzeuger, Verbraucher oder Zähler aus vorhandenen Symcon-Variablen zuordnen. Die Messwerte werden in Watt separat angezeigt, damit bereits erfasste Leistungen nicht doppelt gezählt werden."
        },
        {
          "type": "List",
          "name": "ExternalSystems",
          "caption": "Leistungsquellen",
          "rowCount": 5,
          "add": true,
          "delete": true,
          "columns": [
            {
              "name": "Name",
              "caption": "Name",
              "width": "auto",
              "add": "",
              "edit": {
                "type": "ValidationTextBox"
              }
            },
            {
              "name": "Source",
              "caption": "Symcon-Variable",
              "width": "180px",
              "add": 0,
              "edit": {
                "type": "SelectVariable"
              }
            },
            {
              "name": "Role",
              "caption": "Rolle",
              "width": "130px",
              "add": "other",
              "edit": {
                "type": "Select",
                "options": [
                  {
                    "caption": "Weiteres System",
                    "value": "other"
                  },
                  {
                    "caption": "Erzeuger",
                    "value": "generation"
                  },
                  {
                    "caption": "Verbraucher",
                    "value": "consumption"
                  },
                  {
                    "caption": "Zähler",
                    "value": "meter"
                  }
                ]
              }
            },
            {
              "name": "Unit",
              "caption": "Einheit",
              "width": "80px",
              "add": "W",
              "edit": {
                "type": "Select",
                "options": [
                  {
                    "caption": "W",
                    "value": "W"
                  },
                  {
                    "caption": "kW",
                    "value": "kW"
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "RowLayout",
      "items": [
        {
          "type": "Button",
          "caption": "Jetzt auslesen",
          "onClick": "E3DCF_RefreshMeasurements($id); E3DCF_PollRscpSolar($id); E3DCF_RefreshRscpDetails($id);"
        },
        {
          "type": "Button",
          "caption": "RSCP-Verbindungen testen",
          "onClick": "echo E3DCF_TestRscpConnections($id, false);"
        },
        {
          "type": "Button",
          "caption": "Batterieindizes prüfen",
          "onClick": "echo E3DCF_CheckBatteryIndices($id);"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "RSCP-Ladeeinstellungen",
      "expanded": false,
      "items": [
        {
          "type": "CheckBox",
          "name": "ControlSecond",
          "caption": "Zweites Farmgerät auswählen"
        },
        {
          "type": "Select",
          "name": "RscpSetting",
          "caption": "Einstellung",
          "options": [
            {
              "value": "Leistungslimits",
              "caption": "Leistungslimits"
            },
            {
              "value": "Ladelimit",
              "caption": "Ladelimit"
            },
            {
              "value": "Entladelimit",
              "caption": "Entladelimit"
            },
            {
              "value": "Entladeschwelle",
              "caption": "Entladeschwelle"
            },
            {
              "value": "Stromsparen",
              "caption": "Stromsparen"
            },
            {
              "value": "Wetterbasiertes Laden",
              "caption": "Wetterbasiertes Laden"
            },
            {
              "value": "Wallbox priorisieren",
              "caption": "Wallbox priorisieren"
            },
            {
              "value": "Batterie zur Wallbox entladen",
              "caption": "Batterie zur Wallbox entladen"
            }
          ]
        },
        {
          "type": "NumberSpinner",
          "name": "RscpSettingValue",
          "caption": "Wert in W, bei Schaltern 0 oder 1",
          "minimum": 0,
          "maximum": 100000
        },
        {
          "type": "Button",
          "caption": "Einstellung schreiben",
          "onClick": "try { echo E3DCF_SetRscpSetting($id, $ControlSecond, $RscpSetting, $RscpSettingValue); } catch (Throwable $e) { echo $e->getMessage(); }",
          "confirm": "Einstellung am ausgewählten E3/DC-Gerät ändern?"
        },
        {
          "type": "NumberSpinner",
          "name": "ManualChargeWh",
          "caption": "Manuelle Ladung (Wh)",
          "minimum": 1,
          "maximum": 100000
        },
        {
          "type": "Button",
          "caption": "Manuelle Ladung starten",
          "onClick": "try { echo E3DCF_SetRscpSetting($id, $ControlSecond, \"Manuelle Ladung (Wh)\", $ManualChargeWh); } catch (Throwable $e) { echo $e->getMessage(); }",
          "confirm": "Die manuelle Ladung kann Netzstrom beziehen. Am ausgewählten Gerät starten?"
        },
        {
          "type": "Button",
          "caption": "Notstromtest starten",
          "onClick": "try { echo E3DCF_SetRscpSetting($id, $ControlSecond, \"Notstromtest starten\", 1); } catch (Throwable $e) { echo $e->getMessage(); }",
          "confirm": "Der Notstromtest kann die Stromversorgung unterbrechen. Test wirklich starten?"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Lade- und Entladesperrzeiten",
      "expanded": false,
      "items": [
        {
          "type": "CheckBox",
          "name": "IdleSecond",
          "caption": "Zweites Farmgerät auswählen"
        },
        {
          "type": "Select",
          "name": "IdleType",
          "caption": "Sperre",
          "options": [
            {
              "value": 0,
              "caption": "Laden"
            },
            {
              "value": 1,
              "caption": "Entladen"
            }
          ]
        },
        {
          "type": "Select",
          "name": "IdleDay",
          "caption": "Wochentag",
          "options": [
            {
              "value": 0,
              "caption": "Montag"
            },
            {
              "value": 1,
              "caption": "Dienstag"
            },
            {
              "value": 2,
              "caption": "Mittwoch"
            },
            {
              "value": 3,
              "caption": "Donnerstag"
            },
            {
              "value": 4,
              "caption": "Freitag"
            },
            {
              "value": 5,
              "caption": "Samstag"
            },
            {
              "value": 6,
              "caption": "Sonntag"
            }
          ]
        },
        {
          "type": "CheckBox",
          "name": "IdleActive",
          "caption": "Sperrzeit aktiv"
        },
        {
          "type": "ValidationTextBox",
          "name": "IdleStart",
          "caption": "Beginn (HH:MM)",
          "value": "00:00"
        },
        {
          "type": "ValidationTextBox",
          "name": "IdleEnd",
          "caption": "Ende (HH:MM)",
          "value": "23:59"
        },
        {
          "type": "Button",
          "caption": "Sperrzeit schreiben",
          "onClick": "try { echo E3DCF_SetRscpIdlePeriod($id, $IdleSecond, $IdleType, $IdleDay, $IdleActive, $IdleStart, $IdleEnd); } catch (Throwable $e) { echo $e->getMessage(); }",
          "confirm": "Sperrzeit für den ausgewählten Wochentag ändern?"
        }
      ]
    }
  ],
  "status": [
    {
      "code": 104,
      "icon": "inactive",
      "caption": "Instanz deaktiviert oder IP-Adresse des Hauptgeräts fehlt"
    },
    {
      "code": 201,
      "icon": "error",
      "caption": "Abfrage fehlgeschlagen. Details stehen unter Datenstatus."
    }
  ]
}
