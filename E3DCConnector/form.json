{
  "elements": [
    {
      "type": "CheckBox",
      "name": "Active",
      "caption": "Instanz aktiv"
    },
    {
      "type": "ExpansionPanel",
      "caption": "Lokales RSCP",
      "items": [
        {
          "type": "Label",
          "caption": "Alle Geräteabfragen und Schreibbefehle laufen über lokales RSCP. Der Farmcontroller ist ein eigener RSCP-Endpunkt."
        },
        {
          "type": "CheckBox",
          "name": "ReadRscpSolar",
          "caption": "Lokales RSCP verwenden"
        },
        {
          "type": "NumberSpinner",
          "name": "DeviceRscpPort",
          "caption": "RSCP-Port der Einzelgeräte",
          "minimum": 1,
          "maximum": 65535
        },
        {
          "type": "NumberSpinner",
          "name": "FarmRscpPort",
          "caption": "RSCP-Port des Farmcontrollers",
          "minimum": 1,
          "maximum": 65535
        },
        {
          "type": "ValidationTextBox",
          "name": "FarmRscpUser",
          "caption": "RSCP-Benutzer"
        },
        {
          "type": "PasswordTextBox",
          "name": "FarmRscpPassword",
          "caption": "Passwort des lokalen RSCP-Benutzers"
        },
        {
          "type": "PasswordTextBox",
          "name": "FarmRscpKey",
          "caption": "RSCP-Verschlüsselungsschlüssel"
        },
        {
          "type": "NumberSpinner",
          "name": "RscpDetailInterval",
          "caption": "Detailabfrage (Sekunden, 0 = nur manuell)",
          "minimum": 0,
          "maximum": 3600
        },
        {
          "type": "ExpansionPanel",
          "caption": "Abweichende RSCP-Anmeldung des Hauptgeräts",
          "expanded": false,
          "items": [
            {
              "type": "Label",
              "caption": "Leere Felder verwenden die gemeinsamen RSCP-Zugangsdaten. Diese Einstellungen gelten nur für den Einzelgeräte-Port des Hauptgeräts."
            },
            {
              "type": "ValidationTextBox",
              "name": "MainRscpUser",
              "caption": "RSCP-Benutzer des Hauptgeräts"
            },
            {
              "type": "PasswordTextBox",
              "name": "MainRscpPassword",
              "caption": "Lokales Benutzerpasswort des Hauptgeräts"
            },
            {
              "type": "PasswordTextBox",
              "name": "MainRscpKey",
              "caption": "RSCP-Verschlüsselungsschlüssel des Hauptgeräts"
            }
          ]
        }
      ],
      "expanded": true
    },
    {
      "type": "ExpansionPanel",
      "caption": "Anlage und Geräteerkennung",
      "expanded": true,
      "items": [
        {
          "type": "Select",
          "name": "OperatingMode",
          "caption": "Betriebsart",
          "options": [
            {
              "caption": "Automatisch",
              "value": "auto"
            },
            {
              "caption": "Einzelgerät (Standalone)",
              "value": "standalone"
            },
            {
              "caption": "Farm",
              "value": "farm"
            }
          ],
          "onChange": "if ($OperatingMode === 'farm') { echo E3DCF_DiscoverLAN($id, $LanNetwork ?? '', $Host ?? '', 0, 0, 'farm'); }"
        },
        {
          "type": "Label",
          "caption": "Zuerst die RSCP-Zugangsdaten übernehmen. Bei Auswahl von „Farm“ sucht Symcon nach Farmcontroller und Farmgerät und speichert eine eindeutige Zuordnung."
        },
        {
          "type": "ValidationTextBox",
          "name": "Host",
          "caption": "IP-Adresse des Hauptgeräts oder Farmmasters"
        },
        {
          "type": "Button",
          "caption": "Geräte im LAN suchen",
          "onClick": "echo E3DCF_DiscoverLAN($id, $LanNetwork, $Host, 0, 0, $OperatingMode);"
        },
        {
          "type": "ExpansionPanel",
          "caption": "Erweiterte Netzwerkeinstellungen",
          "expanded": false,
          "items": [
            {
              "type": "ValidationTextBox",
              "name": "LanNetwork",
              "caption": "LAN-Suchnetz (optional, z. B. 192.168.178.0/24)"
            },
            {
              "type": "NumberSpinner",
              "name": "Interval",
              "caption": "Abfrageintervall (Sekunden)",
              "minimum": 5,
              "maximum": 3600
            }
          ]
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Farmgeräte",
      "expanded": false,
      "items": [
        {
          "type": "Label",
          "caption": "Für eine Farm die Adresse des zweiten Geräts hinterlegen. Im Einzelbetrieb bleibt diese Zuordnung gespeichert und wird beim erneuten Wechsel zur Farm wieder verwendet."
        },
        {
          "type": "ValidationTextBox",
          "name": "SecondHost",
          "caption": "IP-Adresse des zweiten Farmgeräts (optional)"
        },
        {
          "type": "ExpansionPanel",
          "caption": "Vorhandene zweite Symcon-Instanz",
          "expanded": false,
          "items": [
            {
              "type": "Label",
              "caption": "Diese Einstellung gilt nur, solange keine zweite IP-Adresse hinterlegt ist."
            },
            {
              "type": "SelectInstance",
              "name": "SecondOne",
              "caption": "Zweite Symcon-Instanz (ältere Einrichtung)"
            }
          ]
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Externe Systeme",
      "expanded": false,
      "items": [
        {
          "type": "Label",
          "caption": "Hier zusätzliche Erzeuger, Verbraucher oder Zähler aus vorhandenen Symcon-Variablen zuordnen. Die Messwerte werden in Watt separat angezeigt, damit bereits erfasste Leistungen nicht doppelt gezählt werden."
        },
        {
          "type": "List",
          "name": "ExternalSystems",
          "caption": "Leistungsquellen",
          "rowCount": 5,
          "add": true,
          "delete": true,
          "columns": [
            {
              "name": "Name",
              "caption": "Name",
              "width": "auto",
              "add": "",
              "edit": {
                "type": "ValidationTextBox"
              }
            },
            {
              "name": "Source",
              "caption": "Symcon-Variable",
              "width": "180px",
              "add": 0,
              "edit": {
                "type": "SelectVariable"
              }
            },
            {
              "name": "Role",
              "caption": "Rolle",
              "width": "130px",
              "add": "other",
              "edit": {
                "type": "Select",
                "options": [
                  {
                    "caption": "Weiteres System",
                    "value": "other"
                  },
                  {
                    "caption": "Erzeuger",
                    "value": "generation"
                  },
                  {
                    "caption": "Verbraucher",
                    "value": "consumption"
                  },
                  {
                    "caption": "Zähler",
                    "value": "meter"
                  }
                ]
              }
            },
            {
              "name": "Unit",
              "caption": "Einheit",
              "width": "80px",
              "add": "W",
              "edit": {
                "type": "Select",
                "options": [
                  {
                    "caption": "W",
                    "value": "W"
                  },
                  {
                    "caption": "kW",
                    "value": "kW"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Zusatzzähler, Wallbox und Zubehör",
      "expanded": false,
      "items": [
        {
          "type": "Label",
          "caption": "Erkannte Geräte erscheinen automatisch. Die Spalte „Funktion“ zeigt ihre automatische Zuordnung. Anzeigename und Sichtbarkeit lassen sich in der Tabelle ändern."
        },
        {
          "type": "List",
          "name": "AccessoryOptions",
          "caption": "Zubehör",
          "rowCount": 6,
          "add": false,
          "delete": false,
          "columns": [
            {
              "caption": "Kennung",
              "name": "Key",
              "width": "130px",
              "save": true
            },
            {
              "caption": "Anzeigename",
              "name": "Name",
              "width": "auto",
              "add": "",
              "edit": {
                "type": "ValidationTextBox"
              }
            },
            {
              "caption": "Funktion",
              "name": "Role",
              "width": "150px",
              "save": false
            },
            {
              "caption": "Status",
              "name": "Current",
              "width": "125px"
            },
            {
              "caption": "Sichtbar",
              "name": "Visible",
              "width": "80px",
              "add": true,
              "edit": {
                "type": "CheckBox"
              }
            }
          ],
          "loadValuesFromConfiguration": false,
          "values": []
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Speicher, Tageswerte und Prognose",
      "expanded": false,
      "items": [
        {
          "type": "ExpansionPanel",
          "caption": "Solarprognose",
          "expanded": false,
          "items": [
            {
              "type": "Label",
              "caption": "Eine vorhandene Prognosevariable in kWh kann hier verknüpft werden."
            },
            {
              "type": "SelectVariable",
              "name": "ForecastSource",
              "caption": "Symcon-Variable für Solarprognose heute (kWh)"
            }
          ]
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Lokale Steuerung",
      "expanded": false,
      "items": [
        {
          "type": "CheckBox",
          "name": "AllowBatteryControl",
          "caption": "Lokale RSCP-Schreibbefehle freigeben"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Jetzt auslesen",
      "onClick": "E3DCF_Poll($id); E3DCF_PollRscpSolar($id);"
    },
    {
      "type": "Button",
      "caption": "RSCP-Verbindungen testen",
      "onClick": "echo E3DCF_TestRscpConnections($id);"
    },
    {
      "type": "ExpansionPanel",
      "caption": "RSCP-Gerätedetails",
      "expanded": false,
      "items": [
        {
          "type": "CheckBox",
          "name": "DetailFarm",
          "caption": "Farmcontroller statt Einzelgerät abfragen"
        },
        {
          "type": "CheckBox",
          "name": "DetailSecond",
          "caption": "Zweites Farmgerät auswählen"
        },
        {
          "type": "Select",
          "name": "DetailGroup",
          "caption": "Datengruppe",
          "options": [
            {
              "value": "INFO",
              "caption": "Geräteinformationen"
            },
            {
              "value": "DCDC",
              "caption": "DC/DC-Wandler"
            },
            {
              "value": "EMS",
              "caption": "Energiemanagement"
            },
            {
              "value": "BAT",
              "caption": "Batterie und Batteriemodule"
            },
            {
              "value": "PVI",
              "caption": "Wechselrichter"
            },
            {
              "value": "PM",
              "caption": "Leistungsmesser"
            },
            {
              "value": "WB",
              "caption": "Wallbox"
            }
          ]
        },
        {
          "type": "NumberSpinner",
          "name": "DetailIndex",
          "caption": "Geräteindex",
          "minimum": 0,
          "maximum": 255
        },
        {
          "type": "Button",
          "caption": "RSCP-Details lesen",
          "onClick": "try { echo E3DCF_ReadRscpDetails($id, ($DetailSecond && !$DetailFarm), $DetailGroup, $DetailIndex, $DetailFarm); } catch (Throwable $e) { echo $e->getMessage(); }"
        },
        {
          "type": "Button",
          "caption": "Alle Datengruppen für Index 0 lesen",
          "onClick": "echo E3DCF_ReadRscpDeviceOverview($id, ($DetailSecond && !$DetailFarm), $DetailFarm);"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "RSCP-Ladeeinstellungen",
      "expanded": false,
      "items": [
        {
          "type": "CheckBox",
          "name": "ControlSecond",
          "caption": "Zweites Farmgerät auswählen"
        },
        {
          "type": "Select",
          "name": "RscpSetting",
          "caption": "Einstellung",
          "options": [
            {
              "value": "Leistungslimits",
              "caption": "Leistungslimits"
            },
            {
              "value": "Ladelimit",
              "caption": "Ladelimit"
            },
            {
              "value": "Entladelimit",
              "caption": "Entladelimit"
            },
            {
              "value": "Entladeschwelle",
              "caption": "Entladeschwelle"
            },
            {
              "value": "Stromsparen",
              "caption": "Stromsparen"
            },
            {
              "value": "Wetterbasiertes Laden",
              "caption": "Wetterbasiertes Laden"
            },
            {
              "value": "Wallbox priorisieren",
              "caption": "Wallbox priorisieren"
            },
            {
              "value": "Batterie zur Wallbox entladen",
              "caption": "Batterie zur Wallbox entladen"
            }
          ]
        },
        {
          "type": "NumberSpinner",
          "name": "RscpSettingValue",
          "caption": "Wert in W, bei Schaltern 0 oder 1",
          "minimum": 0,
          "maximum": 100000
        },
        {
          "type": "Button",
          "caption": "Einstellung schreiben",
          "onClick": "try { echo E3DCF_SetRscpSetting($id, $ControlSecond, $RscpSetting, $RscpSettingValue); } catch (Throwable $e) { echo $e->getMessage(); }",
          "confirm": "Einstellung am ausgewählten E3/DC-Gerät ändern?"
        },
        {
          "type": "NumberSpinner",
          "name": "ManualChargeWh",
          "caption": "Manuelle Ladung (Wh)",
          "minimum": 1,
          "maximum": 100000
        },
        {
          "type": "Button",
          "caption": "Manuelle Ladung starten",
          "onClick": "try { echo E3DCF_SetRscpSetting($id, $ControlSecond, \"Manuelle Ladung (Wh)\", $ManualChargeWh); } catch (Throwable $e) { echo $e->getMessage(); }",
          "confirm": "Die manuelle Ladung kann Netzstrom beziehen. Am ausgewählten Gerät starten?"
        },
        {
          "type": "Button",
          "caption": "Notstromtest starten",
          "onClick": "try { echo E3DCF_SetRscpSetting($id, $ControlSecond, \"Notstromtest starten\", 1); } catch (Throwable $e) { echo $e->getMessage(); }",
          "confirm": "Der Notstromtest kann die Stromversorgung unterbrechen. Test wirklich starten?"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Lade- und Entladesperrzeiten",
      "expanded": false,
      "items": [
        {
          "type": "CheckBox",
          "name": "IdleSecond",
          "caption": "Zweites Farmgerät auswählen"
        },
        {
          "type": "Select",
          "name": "IdleType",
          "caption": "Sperre",
          "options": [
            {
              "value": 0,
              "caption": "Laden"
            },
            {
              "value": 1,
              "caption": "Entladen"
            }
          ]
        },
        {
          "type": "Select",
          "name": "IdleDay",
          "caption": "Wochentag",
          "options": [
            {
              "value": 0,
              "caption": "Montag"
            },
            {
              "value": 1,
              "caption": "Dienstag"
            },
            {
              "value": 2,
              "caption": "Mittwoch"
            },
            {
              "value": 3,
              "caption": "Donnerstag"
            },
            {
              "value": 4,
              "caption": "Freitag"
            },
            {
              "value": 5,
              "caption": "Samstag"
            },
            {
              "value": 6,
              "caption": "Sonntag"
            }
          ]
        },
        {
          "type": "CheckBox",
          "name": "IdleActive",
          "caption": "Sperrzeit aktiv"
        },
        {
          "type": "ValidationTextBox",
          "name": "IdleStart",
          "caption": "Beginn (HH:MM)",
          "value": "00:00"
        },
        {
          "type": "ValidationTextBox",
          "name": "IdleEnd",
          "caption": "Ende (HH:MM)",
          "value": "23:59"
        },
        {
          "type": "Button",
          "caption": "Sperrzeit schreiben",
          "onClick": "try { echo E3DCF_SetRscpIdlePeriod($id, $IdleSecond, $IdleType, $IdleDay, $IdleActive, $IdleStart, $IdleEnd); } catch (Throwable $e) { echo $e->getMessage(); }",
          "confirm": "Sperrzeit für den ausgewählten Wochentag ändern?"
        }
      ]
    }
  ],
  "status": [
    {
      "code": 104,
      "icon": "inactive",
      "caption": "Instanz deaktiviert oder IP-Adresse des Hauptgeräts fehlt"
    },
    {
      "code": 201,
      "icon": "error",
      "caption": "Abfrage fehlgeschlagen. Details stehen unter Datenstatus."
    }
  ]
}
