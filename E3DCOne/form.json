{
  "elements": [
    {
      "type": "CheckBox",
      "name": "Active",
      "caption": "Instanz aktiv"
    },
    {
      "type": "ExpansionPanel",
      "caption": "Netzwerk und Verbindung",
      "items": [
        {
          "type": "Label",
          "caption": "Für die Ersteinrichtung die LAN-Suche starten. Symcon erkennt das lokale Netz und speichert zwei eindeutig zugeordnete Geräte automatisch."
        },
        {
          "type": "Button",
          "caption": "E3/DC one suchen und einrichten",
          "onClick": "echo E3DCF_DiscoverLAN($id, $LanNetwork, $Host, $Port, $Unit);"
        },
        {
          "type": "ValidationTextBox",
          "name": "Host",
          "caption": "IP-Adresse des Farmmasters"
        },
        {
          "type": "ValidationTextBox",
          "name": "SecondHost",
          "caption": "IP-Adresse des zweiten one"
        },
        {
          "type": "ValidationTextBox",
          "name": "LanNetwork",
          "caption": "LAN-Suchnetz (optional, z. B. 192.168.178.0/24)"
        },
        {
          "type": "NumberSpinner",
          "name": "Port",
          "caption": "Modbus-TCP-Port",
          "minimum": 1,
          "maximum": 65535
        },
        {
          "type": "NumberSpinner",
          "name": "Unit",
          "caption": "Modbus Unit-ID",
          "minimum": 0,
          "maximum": 255
        },
        {
          "type": "NumberSpinner",
          "name": "Interval",
          "caption": "Abfrageintervall (Sekunden)",
          "minimum": 5,
          "maximum": 3600
        }
      ],
      "expanded": true
    },
    {
      "type": "ExpansionPanel",
      "caption": "Farm und Wallbox",
      "items": [
        {
          "type": "Label",
          "caption": "Bei automatischer Zuordnung werden eindeutige Zähler und Wallbox-Slots verwendet. Bei mehreren Treffern bitte den Index oder Slot wählen."
        },
        {
          "type": "CheckBox",
          "name": "AutoFarmDevices",
          "caption": "Zähler und Wallbox automatisch erkennen"
        },
        {
          "type": "NumberSpinner",
          "name": "FarmConsumptionMeter",
          "caption": "Index Farm-Verbrauchszähler (−1 = automatisch)",
          "minimum": -1,
          "maximum": 7
        },
        {
          "type": "CheckBox",
          "name": "FarmMeterIsConsumption",
          "caption": "Farmzähler ist ein reiner Verbrauchszähler"
        },
        {
          "type": "Label",
          "caption": "Standardmäßig wird der Farmzähler als Netz-Messpunkt verwendet. Nur bei einem separaten Gesamtverbrauchszähler umschalten."
        },
        {
          "type": "NumberSpinner",
          "name": "HeatPumpMeter",
          "caption": "Index Wärmepumpenzähler (−1 = automatisch)",
          "minimum": -1,
          "maximum": 7
        },
        {
          "type": "CheckBox",
          "name": "ReadWallbox",
          "caption": "Wallbox auch ohne automatische Erkennung auslesen"
        },
        {
          "type": "NumberSpinner",
          "name": "WallboxSlot",
          "caption": "Wallbox-Slot (−1 = automatisch)",
          "minimum": -1,
          "maximum": 7
        }
      ],
      "expanded": false
    },
    {
      "type": "ExpansionPanel",
      "caption": "Solar-Tagesertrag über lokales RSCP",
      "items": [
        {
          "type": "Label",
          "caption": "Liest den gesamten gemessenen Farm-Tagesertrag vom Farmmaster auf Port 5034. Beide RSCP-Passwörter werden in der lokalen Symcon-Konfiguration hinterlegt."
        },
        {
          "type": "CheckBox",
          "name": "ReadRscpSolar",
          "caption": "Solar-Tagesertrag vom Farmcontroller auslesen"
        },
        {
          "type": "NumberSpinner",
          "name": "FarmRscpPort",
          "caption": "RSCP-Port des Farmcontrollers",
          "minimum": 1,
          "maximum": 65535
        },
        {
          "type": "ValidationTextBox",
          "name": "FarmRscpUser",
          "caption": "RSCP-Benutzer"
        },
        {
          "type": "PasswordTextBox",
          "name": "FarmRscpPassword",
          "caption": "Passwort des lokalen RSCP-Benutzers"
        },
        {
          "type": "PasswordTextBox",
          "name": "FarmRscpKey",
          "caption": "RSCP-Verschlüsselungsschlüssel"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Speicher und Prognose",
      "items": [
        {
          "type": "Label",
          "caption": "Ersatzkapazitäten in Wh nur eintragen, wenn das Gerät keine gültige Kapazität meldet. Die Prognosequelle liefert kWh."
        },
        {
          "type": "NumberSpinner",
          "name": "CapacityFallbackWh",
          "caption": "Nutzbare Speicherkapazität als Ersatzwert (Wh, 0 = aus)",
          "minimum": 0,
          "maximum": 1000000
        },
        {
          "type": "NumberSpinner",
          "name": "SecondCapacityFallbackWh",
          "caption": "Nutzbare Ersatzkapazität des zweiten one (Wh, 0 = aus)",
          "minimum": 0,
          "maximum": 1000000
        },
        {
          "type": "SelectVariable",
          "name": "ForecastSource",
          "caption": "Symcon-Variable für Solarprognose heute (kWh)"
        }
      ],
      "expanded": false
    },
    {
      "type": "ExpansionPanel",
      "caption": "Bestehende Einrichtung",
      "items": [
        {
          "type": "Label",
          "caption": "Diese Einstellung gilt nur, solange keine zweite IP-Adresse hinterlegt ist."
        },
        {
          "type": "SelectInstance",
          "name": "SecondOne",
          "caption": "Zweite Symcon-Instanz (ältere Einrichtung)"
        }
      ],
      "expanded": false
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Jetzt auslesen",
      "onClick": "E3DCF_Poll($id); E3DCF_PollRscpSolar($id);"
    }
  ],
  "status": [
    {
      "code": 104,
      "icon": "inactive",
      "caption": "Instanz deaktiviert oder Farmmaster-IP fehlt"
    },
    {
      "code": 201,
      "icon": "error",
      "caption": "Abfrage fehlgeschlagen. Details stehen unter Datenstatus."
    }
  ]
}
