{
  "elements": [
    {
      "type": "CheckBox",
      "name": "Active",
      "caption": "Instanz aktiv"
    },
    {
      "type": "ExpansionPanel",
      "caption": "Anlage und Geräteerkennung",
      "expanded": true,
      "items": [
        {
          "type": "Select",
          "name": "OperatingMode",
          "caption": "Betriebsart",
          "options": [
            {
              "caption": "Automatisch",
              "value": "auto"
            },
            {
              "caption": "Einzelgerät (Standalone)",
              "value": "standalone"
            },
            {
              "caption": "Farm",
              "value": "farm"
            }
          ]
        },
        {
          "type": "Label",
          "caption": "Automatisch verwendet ein Einzelgerät oder eine Farm mit zugeordnetem zweitem Gerät. Die LAN-Suche übernimmt eindeutige Treffer. Bei mehreren unabhängigen Anlagen zuerst das gewünschte Hauptgerät auswählen."
        },
        {
          "type": "ValidationTextBox",
          "name": "Host",
          "caption": "IP-Adresse des Hauptgeräts oder Farmmasters"
        },
        {
          "type": "Button",
          "caption": "Geräte im LAN suchen",
          "onClick": "echo E3DCF_DiscoverLAN($id, $LanNetwork, $Host, $Port, $Unit, $OperatingMode);"
        },
        {
          "type": "ExpansionPanel",
          "caption": "Erweiterte Netzwerkeinstellungen",
          "expanded": false,
          "items": [
            {
              "type": "ValidationTextBox",
              "name": "LanNetwork",
              "caption": "LAN-Suchnetz (optional, z. B. 192.168.178.0/24)"
            },
            {
              "type": "NumberSpinner",
              "name": "Port",
              "caption": "Modbus-TCP-Port",
              "minimum": 1,
              "maximum": 65535
            },
            {
              "type": "NumberSpinner",
              "name": "Unit",
              "caption": "Modbus Unit-ID",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "NumberSpinner",
              "name": "Interval",
              "caption": "Abfrageintervall (Sekunden)",
              "minimum": 5,
              "maximum": 3600
            }
          ]
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Farm und Messpunkte",
      "expanded": false,
      "items": [
        {
          "type": "Label",
          "caption": "Für eine Farm die Adresse des zweiten Geräts hinterlegen. Im Einzelbetrieb bleibt diese Zuordnung gespeichert und wird beim erneuten Wechsel zur Farm wieder verwendet."
        },
        {
          "type": "ValidationTextBox",
          "name": "SecondHost",
          "caption": "IP-Adresse des zweiten Farmgeräts (optional)"
        },
        {
          "type": "CheckBox",
          "name": "AutoFarmDevices",
          "caption": "Zähler und Wallbox automatisch erkennen"
        },
        {
          "type": "NumberSpinner",
          "name": "FarmConsumptionMeter",
          "caption": "Index Farm-Verbrauchszähler (−1 = automatisch)",
          "minimum": -1,
          "maximum": 7
        },
        {
          "type": "CheckBox",
          "name": "FarmMeterIsConsumption",
          "caption": "Farmzähler ist ein reiner Verbrauchszähler"
        },
        {
          "type": "Label",
          "caption": "Standardmäßig wird der Farmzähler als Netz-Messpunkt verwendet. Nur bei einem separaten Gesamtverbrauchszähler umschalten."
        },
        {
          "type": "NumberSpinner",
          "name": "HeatPumpMeter",
          "caption": "Index Wärmepumpenzähler (−1 = automatisch)",
          "minimum": -1,
          "maximum": 7
        },
        {
          "type": "ExpansionPanel",
          "caption": "Vorhandene zweite Symcon-Instanz",
          "expanded": false,
          "items": [
            {
              "type": "Label",
              "caption": "Diese Einstellung gilt nur, solange keine zweite IP-Adresse hinterlegt ist."
            },
            {
              "type": "SelectInstance",
              "name": "SecondOne",
              "caption": "Zweite Symcon-Instanz (ältere Einrichtung)"
            }
          ]
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Externe Systeme",
      "expanded": false,
      "items": [
        {
          "type": "Label",
          "caption": "Hier zusätzliche Erzeuger, Verbraucher oder Zähler aus vorhandenen Symcon-Variablen zuordnen. Die Messwerte werden in Watt separat angezeigt, damit bereits erfasste Leistungen nicht doppelt gezählt werden."
        },
        {
          "type": "List",
          "name": "ExternalSystems",
          "caption": "Leistungsquellen",
          "rowCount": 5,
          "add": true,
          "delete": true,
          "columns": [
            {
              "name": "Name",
              "caption": "Name",
              "width": "auto",
              "add": "",
              "edit": {
                "type": "ValidationTextBox"
              }
            },
            {
              "name": "Source",
              "caption": "Symcon-Variable",
              "width": "180px",
              "add": 0,
              "edit": {
                "type": "SelectVariable"
              }
            },
            {
              "name": "Role",
              "caption": "Rolle",
              "width": "130px",
              "add": "other",
              "edit": {
                "type": "Select",
                "options": [
                  {
                    "caption": "Weiteres System",
                    "value": "other"
                  },
                  {
                    "caption": "Erzeuger",
                    "value": "generation"
                  },
                  {
                    "caption": "Verbraucher",
                    "value": "consumption"
                  },
                  {
                    "caption": "Zähler",
                    "value": "meter"
                  }
                ]
              }
            },
            {
              "name": "Unit",
              "caption": "Einheit",
              "width": "80px",
              "add": "W",
              "edit": {
                "type": "Select",
                "options": [
                  {
                    "caption": "W",
                    "value": "W"
                  },
                  {
                    "caption": "kW",
                    "value": "kW"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Wallbox und Zubehör",
      "expanded": false,
      "items": [
        {
          "type": "Label",
          "caption": "Bei mehreren erkannten Wallboxen den Slot für die Übersicht wählen. Erkannte Komponenten erscheinen unter „Zubehör und Messpunkte“."
        },
        {
          "type": "CheckBox",
          "name": "ReadWallbox",
          "caption": "Wallbox auch ohne automatische Erkennung auslesen"
        },
        {
          "type": "NumberSpinner",
          "name": "WallboxSlot",
          "caption": "Wallbox-Slot (−1 = automatisch)",
          "minimum": -1,
          "maximum": 7
        },
        {
          "type": "ValidationTextBox",
          "name": "AccessoryNames",
          "caption": "Zubehörnamen als JSON, z. B. {\"Wallbox0\":\"Garage\",\"Zaehler4\":\"Wärmepumpe\"}"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Speicher, Tageswerte und Prognose",
      "expanded": false,
      "items": [
        {
          "type": "Label",
          "caption": "Ersatzkapazitäten nur angeben, wenn das Gerät keine plausible Kapazität liefert. Für die Prognose lässt sich eine vorhandene Symcon-Variable in kWh wählen."
        },
        {
          "type": "NumberSpinner",
          "name": "CapacityFallbackWh",
          "caption": "Nutzbare Speicherkapazität als Ersatzwert (Wh, 0 = aus)",
          "minimum": 0,
          "maximum": 1000000
        },
        {
          "type": "NumberSpinner",
          "name": "SecondCapacityFallbackWh",
          "caption": "Nutzbare Ersatzkapazität des zweiten one (Wh, 0 = aus)",
          "minimum": 0,
          "maximum": 1000000
        },
        {
          "type": "SelectVariable",
          "name": "ForecastSource",
          "caption": "Symcon-Variable für Solarprognose heute (kWh)"
        },
        {
          "type": "ExpansionPanel",
          "caption": "Solar-Tagesertrag über lokales RSCP",
          "items": [
            {
              "type": "Label",
              "caption": "Liest den gesamten gemessenen Farm-Tagesertrag vom Farmmaster auf Port 5034. Beide RSCP-Passwörter werden in der lokalen Symcon-Konfiguration hinterlegt."
            },
            {
              "type": "CheckBox",
              "name": "ReadRscpSolar",
              "caption": "Solar-Tagesertrag vom Farmcontroller auslesen"
            },
            {
              "type": "NumberSpinner",
              "name": "FarmRscpPort",
              "caption": "RSCP-Port des Farmcontrollers",
              "minimum": 1,
              "maximum": 65535
            },
            {
              "type": "ValidationTextBox",
              "name": "FarmRscpUser",
              "caption": "RSCP-Benutzer"
            },
            {
              "type": "PasswordTextBox",
              "name": "FarmRscpPassword",
              "caption": "Passwort des lokalen RSCP-Benutzers"
            },
            {
              "type": "PasswordTextBox",
              "name": "FarmRscpKey",
              "caption": "RSCP-Verschlüsselungsschlüssel"
            }
          ]
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Lokale Steuerung",
      "expanded": false,
      "items": [
        {
          "type": "Label",
          "caption": "Die Freigaben gelten für die Symcon-Skriptbefehle. Das jeweilige Gerät muss die Modbus-Register unterstützen."
        },
        {
          "type": "CheckBox",
          "name": "AllowWallboxControl",
          "caption": "Wallbox-Steuerbefehle am Hauptgerät erlauben"
        },
        {
          "type": "CheckBox",
          "name": "AllowBatteryControl",
          "caption": "Zeitlich begrenzte Batterie-Leistungsvorgaben erlauben"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Jetzt auslesen",
      "onClick": "E3DCF_Poll($id); E3DCF_PollRscpSolar($id);"
    }
  ],
  "status": [
    {
      "code": 104,
      "icon": "inactive",
      "caption": "Instanz deaktiviert oder IP-Adresse des Hauptgeräts fehlt"
    },
    {
      "code": 201,
      "icon": "error",
      "caption": "Abfrage fehlgeschlagen. Details stehen unter Datenstatus."
    }
  ]
}
