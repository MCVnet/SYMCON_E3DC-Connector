    {
      "type": "NumberSpinner",
      "name": "HeatPumpMeter",
      "caption": "Index Wärmepumpenzähler (−1: aus)",
      "minimum": -1,
      "maximum": 7
    },
    {
      "type": "SelectInstance",
      "name": "SecondOne",
      "caption": "Zweiter one für die Farm-Batteriewerte"
    },
    {
      "type": "SelectVariable",
